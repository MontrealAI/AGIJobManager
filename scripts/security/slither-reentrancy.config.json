{
  "filter_paths": "(^|/)(node_modules|lib|build|forge-test|test)(/|$)|(^|/)contracts/(test|legacy)(/|$)",
  "exclude_dependencies": true,
  "exclude_informational": false,
  "exclude_low": false,
  "exclude_optimization": true,
  "solc_remaps": [
    "@openzeppelin/=node_modules/@openzeppelin/"
  ],
  "detectors_to_run": "reentrancy-balance,reentrancy-eth,reentrancy-no-eth,reentrancy-benign,reentrancy-events,reentrancy-unlimited-gas",
  "detectors_to_exclude": []
}
