+    def test_37_only_reviewed_plumbing_record_changes_with_all_policy_functions_retained(self):
+        old = ast.parse((MODULE_PATH.parent / "before-plumbing-policy/prepare.py").read_bytes())
+        new = ast.parse(MODULE_PATH.read_bytes())
+        node = next(n.value for n in old.body if isinstance(n, ast.Assign)
+                    and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name)
+                    and n.targets[0].id == "FIXED_REVIEWED_OVERLAYS")
+        previous = {(P.BOUNDARY_PATH if isinstance(k, ast.Name) else ast.literal_eval(k)): ast.literal_eval(v)
+                    for k, v in zip(node.keys, node.values)}
+        self.assertEqual(set(previous), set(P.FIXED_REVIEWED_OVERLAYS))
+        self.assertEqual({p for p in previous if previous[p] != P.FIXED_REVIEWED_OVERLAYS[p]},
+                         {P.PLUMBING_CORRECTION_PATH})
+        self.assertEqual(previous[P.PLUMBING_CORRECTION_PATH], {
+            "mode": "100644", "blob": "f5123723938915e2152cc944a3acd7cf7a043fe1", "bytes": 74322,
+            "sha256": "5a460bf0f9cb76b99552847bca33da5bf7b40d8886487d1cd8fa349bffa6a2d9"})
+        self.assertEqual(P.FIXED_REVIEWED_OVERLAYS[P.PLUMBING_CORRECTION_PATH], {
+            "mode": "100644", "blob": "16e0dec1840d4786cc1a2667f2f703370e7b134c", "bytes": 74777,
+            "sha256": "c321cc9de4d0e223522b94a016a9d6725cb2821addc23fd6d7df2c7fcb2783b5"})
+        self.assertEqual(P.FIXED_CORRECTION_PROVENANCE[P.PLUMBING_CORRECTION_PATH],
+                         "392db1da9c0a08c13b40009217727028f4d7ecf9")
+        def functions(tree):
+            return {n.name: ast.dump(n, include_attributes=False) for n in tree.body
+                    if isinstance(n, ast.FunctionDef)}
+        self.assertEqual(functions(old), functions(new))
+        for name in ("API_ROLE_FACTS", "TEMPLATE_BYTES", "TEMPLATE_SHA256", "CEILINGS", "FALSE_FLAGS",
+                     "SIDECARS", "FRESH_SNAPSHOT_ROLES", "COMMON_SEVENTEEN"):
+            def value(tree):
+                return next(n.value for n in tree.body if isinstance(n, ast.Assign)
+                    and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id == name)
+            self.assertEqual(ast.dump(value(old), include_attributes=False),
+                             ast.dump(value(new), include_attributes=False))
+        basis, current, before, overlays, trees = self.scope_fixture()
+        P.source_basis_metadata(basis, current, before, overlays, trees)
+        self.assertEqual(basis["currentFinite"][P.PLUMBING_CORRECTION_PATH]["status"], "A")
+        self.assertEqual(basis["finalFinite"][P.PLUMBING_CORRECTION_PATH]["status"], "A")
+        self.assertNotIn(P.PLUMBING_CORRECTION_PATH, basis["protected"])
+        self.assertEqual((len(P.FIXED_REVIEWED_OVERLAYS), len(P.CONTEXTUAL_OVERLAYS), len(P.OVERLAY_PATHS)),
+                         (15, 5, 20))
+        self.assertEqual((len(before), len(basis["finalFinite"]), len(basis["protected"])), (38, 85, 1589))
