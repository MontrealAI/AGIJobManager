{
  "name": "agi-job-manager-ui",
  "version": "1.0.5",
  "private": true,
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fuzz": "vitest run tests/fuzz.invariants.test.ts",
    "test:watch": "vitest",
    "test:e2e": "NEXT_PUBLIC_DEMO_MODE=1 NEXT_PUBLIC_DEMO_ACTOR=visitor npm run build && playwright test e2e/demo.spec.ts e2e/smoke.spec.ts",
    "test:a11y": "NEXT_PUBLIC_DEMO_MODE=1 NEXT_PUBLIC_DEMO_ACTOR=visitor npm run build && playwright test e2e/a11y.spec.ts",
    "test:headers": "NEXT_PUBLIC_DEMO_MODE=1 NEXT_PUBLIC_DEMO_ACTOR=visitor npm run build && playwright test e2e/headers.spec.ts",
    "test:security": "npm run build:ipfs && npm run verify:singlefile",
    "check:no-binaries": "node scripts/check-no-binaries.mjs",
    "docs:versions": "node scripts/generate-versions.mjs",
    "docs:contract": "node scripts/generate-contract-interface.mjs",
    "docs:deployment": "node scripts/sync-deployments.mjs && node scripts/generate-deployment-docs.mjs",
    "docs:check": "node scripts/docs-check.mjs && node scripts/check-no-binaries.mjs",
    "sync:deployment": "node scripts/sync-deployments.mjs",
    "sync:deployments": "node scripts/sync-deployments.mjs",
    "sync:deployments:check": "node scripts/sync-deployments.mjs --check",
    "build:ipfs": "npm run build && node scripts/build-ipfs.mjs",
    "verify:ipfs": "npm run verify:singlefile",
    "verify:singlefile": "node scripts/verify-singlefile.mjs",
    "verify:deterministic": "node scripts/verify-deterministic-build.mjs",
    "verify:committed-html": "node scripts/ensure-committed-html-fresh.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "lucide-react": "0.445.0",
    "next": "15.5.24",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "tailwind-merge": "2.5.2",
    "viem": "2.56.7",
    "wagmi": "2.19.5",
    "zod": "3.23.8",
    "@agijobmanager/async-storage-browser": "file:vendor/async-storage-browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.20.3",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "fast-check": "3.20.0",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28",
    "ws@^8.0.0": "8.21.0",
    "picomatch@^2.0.0": "2.3.2",
    "decode-uri-component": "$decode-uri-component",
    "uuid": "11.1.1",
    "picomatch@^4.0.0": "4.0.4"
  }
}
