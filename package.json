{
  "name": "agijobmanager",
  "version": "1.10.0",
  "private": true,
  "description": "USDC job escrow, bonded review and buyer recovery with fixed linked libraries",
  "scripts": {
    "build": "npm --prefix hardhat run compile && node scripts/export-contract-artifacts.js",
    "size": "node scripts/check-bytecode-size.js",
    "check:no-binaries": "node scripts/check-no-binaries.mjs",
    "docs:gen": "node scripts/docs/gen-docs.mjs",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "docs:ens:gen": "node scripts/docs/generate-ens-reference.mjs",
    "docs:ens:check": "node scripts/docs/check-ens-docs.mjs",
    "docs:interface": "node scripts/generate-interface-doc.js",
    "lint": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "test": "npm run build && node scripts/test-contract-shard.js 0 1",
    "test:ui": "node scripts/ui/run_ui_smoke_test.js",
    "test:ui:usdc": "node scripts/ui/run_usdc_console_test.js",
    "ui:abi": "node scripts/ui/export_abi.js",
    "ui:abi:check": "node scripts/ui/check_ui_abi.js",
    "merkle:proof": "node scripts/merkle/generate_merkle_proof.js",
    "merkle:export": "node scripts/merkle/export_merkle_proofs.js",
    "etherscan:prep": "node scripts/etherscan/prepare_inputs.js",
    "advisor:job": "node scripts/advisor/state_advisor.js",
    "forge:build": "forge build --deny warnings",
    "forge:test": "forge test",
    "forge:invariant": "FOUNDRY_PROFILE=ci forge test --match-path forge-test/invariant/*.t.sol",
    "slither": "./scripts/security/run-slither.sh",
    "deploy:agijobmanager:prod": "npm --prefix hardhat run deploy:mainnet",
    "slither:extended": "bash scripts/security/run-slither-extended.sh",
    "test:shard": "node scripts/test-contract-shard.js",
    "postinstall": "node scripts/security/patch-openzeppelin-compiler.cjs",
    "economics:check": "node scripts/economics/assess.cjs",
    "simulate:genesis": "npm --prefix hardhat run compile && node scripts/simulate-genesis-job.mjs",
    "docs:terms": "node scripts/docs/sync-protocol-terms.mjs",
    "settlement:status": "node scripts/ops/settlement-status.mjs",
    "economics:screen": "node scripts/economics/screen.cjs",
    "economics:lifecycle": "node scripts/economics/lifecycle.cjs",
    "economics:admission": "node scripts/economics/admission.cjs",
    "economics:funding": "node scripts/economics/admission.cjs",
    "economics:calibrate": "node scripts/economics/calibration.cjs",
    "economics:benchmark": "node scripts/economics/benchmark-qualification.mjs",
    "computer:check": "node scripts/economics/computer-work.cjs",
    "computer:report": "node scripts/economics/capability-report.cjs",
    "economics:example": "node scripts/economics/admission-example.cjs",
    "workforce:qualify": "node scripts/economics/workforce.cjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.6.1",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.6.0",
    "solc": "0.8.37",
    "solhint": "6.2.4",
    "ethers": "6.17.0",
    "bn.js": "5.2.5",
    "mocha": "12.0.2",
    "hardhat": "3.17.0"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "type": "module"
}
