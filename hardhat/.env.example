# Supported Hardhat environment. Shell variables take precedence.
# Loaded from hardhat/.env, independent of the working directory.
# Complete reference: docs/DEPLOYMENT_CONFIGURATION.md

# RPC endpoints and disposable deployer (leave the key empty for read-only work).
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Required for broadcasts and explorer verification recovery, not read-only plans.
ETHERSCAN_API_KEY=

# Defaults to hardhat/deploy.config.cjs. Relative overrides use command working directory.
DEPLOY_CONFIG=
# Overrides the selected profile's explicit finalOwner; never defaults to deployer.
FINAL_OWNER=
# Unset/empty also defaults to read-only in current tooling. Set DRY_RUN=0 explicitly to send.
DRY_RUN=1
CONFIRMATIONS=3
VERIFY_DELAY_MS=3500
# Only for the authorized mainnet broadcast; never needed for read-only commands.
DEPLOY_CONFIRM_MAINNET=

# Optional ENS helper: manager ownership must be accepted and intake paused.
JOB_MANAGER=
# Explicit one-step helper owner; falls back to FINAL_OWNER, not the config profile.
NEW_OWNER=
ENS_DEPLOYMENT_MODE=fresh
VERIFY=1
LOCK_CONFIG=0
# Optional assertions; fresh mode derives these from chain + full manager address.
JOB_LABEL_PREFIX=
JOBS_ROOT_NAME=
JOBS_ROOT_NODE=
# Mainnet defaults are built in. Sepolia requires all three explicitly.
# Only NAME_WRAPPER permits an explicit zero address for an unwrapped route.
ENS_REGISTRY=
NAME_WRAPPER=
PUBLIC_RESOLVER=

# Read-only recovery/readiness; paths are relative to the command working directory.
DEPLOYMENT_RECEIPT=
# Optional reviewed identity changes; preserve the original deployment receipt.
READINESS_CONFIG=
# Required for readiness; choose required/optional and the complete expected registry.
READINESS_NFT_CONFIG=./reviewed-nft-policy.json

# Optional endpoint for pinned local mainnet-fork tests (archive state required).
MAINNET_FORK_RPC_URL=
# Optional local cutover report path; never a public-chain deployment receipt.
CUTOVER_REPORT=

# Optional review escrow: verify the existing manager independently.
JOB_MANAGER_CODE_HASH=
VERIFY_RPC_URL=
# Set only to recover verification of the address in the original review journal.
REVIEW_ESCROW_ADDRESS=
