MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Explicit owner override; otherwise use the reviewed deploy.config.cjs finalOwner.
FINAL_OWNER=
DEPLOY_CONFIRM_MAINNET=
DRY_RUN=
CONFIRMATIONS=
VERIFY_DELAY_MS=
# Optional path to a reviewed copy; defaults to hardhat/deploy.config.cjs, never the example.
DEPLOY_CONFIG=
NEW_OWNER=
VERIFY=
LOCK_CONFIG=
JOB_MANAGER=
# Fresh mode derives a namespace from chain ID + full JOB_MANAGER address.
ENS_DEPLOYMENT_MODE=fresh
# Mainnet default: alpha.jobs.agi.eth. Sepolia requires an explicit reviewed parent.
JOBS_PARENT_NAME=
# Optional assertions; leave blank to use the derived fresh namespace.
JOBS_ROOT_NAME=
JOBS_ROOT_NODE=
JOB_LABEL_PREFIX=
# Same-manager replacement only: select mode=replacement and its current helper.
REPLACES_ENS_JOB_PAGES=
# ENS helper defaults are mainnet-only; set all three explicitly for Sepolia.
ENS_REGISTRY=
NAME_WRAPPER=
PUBLIC_RESOLVER=

# Read-only deployment planning and readiness (no PRIVATE_KEY needed)
DEPLOYER_ADDRESS=
DEPLOYMENT_RECEIPT=
# Optional reviewed identity changes for read-only readiness; preserve the original receipt.
READINESS_CONFIG=
