{
  "name": "agijobmanager-hardhat",
  "private": true,
  "version": "0.8.0",
  "description": "Official Hardhat deployment + verification workflow for AGIJobManager",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:ens-job-pages:mainnet": "hardhat run scripts/deploy-ens-job-pages.js --network mainnet",
    "deploy:ens-job-pages:sepolia": "hardhat run scripts/deploy-ens-job-pages.js --network sepolia",
    "test:preflight": "node --test test/deployment-preflight.test.cjs",
    "test:deployment": "hardhat test test/mainnet-deployment.test.js",
    "test:mainnet-fork": "hardhat test --config mainnet-fork.config.js test/mainnet-fork.test.js",
    "check:readiness": "hardhat run scripts/check-readiness.js --network mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/contracts": "4.9.6",
    "dotenv": "^16.6.1",
    "ethers": "6.17.0",
    "hardhat": "^2.26.3"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "overrides": {
    "undici": "6.28.1",
    "adm-zip": "0.6.1",
    "uuid": "11.1.1",
    "serialize-javascript": "7.0.5",
    "tmp": "0.2.7"
  }
}
