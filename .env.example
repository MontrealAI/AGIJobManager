# Public deployment uses hardhat/.env, not this file.
# From the repository root: npm ci && npm --prefix hardhat ci
# Then: npm --prefix hardhat run setup
# Follow hardhat/README.md and docs/DEPLOYMENT_CONFIGURATION.md.
# PRIVATE_KEYS, ALCHEMY_KEY, Ganache and Truffle settings are retired.

# Optional exported settings for the read-only Node operator scripts.
# Node operator scripts load .env from their working directory; shell values win.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
RPC_URL=
AGIJOBMANAGER_ADDRESS=
# Local-only owner rehearsal; public writes use the verified console/governance wallet.
TX_FROM=
AGI_CONFIG_PATH=

# Optional generic AGIJobPages router (not ENSJobPages). Reviewed JSON only.
# See docs/DEPLOYMENT/OPTIONAL_METADATA_ROUTER.md. Dry-run is the default.
# ROUTER_CONFIG=/absolute/reviewed-router.json
# ROUTER_JOURNAL=/absolute/new-or-original-router-journal.json
# ROUTER_REVERIFY=1
# ROUTER_REPORT=/absolute/new-reverification-report.json
